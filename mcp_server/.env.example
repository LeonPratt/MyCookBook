# Add privately to the existing shared/.env (not a separate database).
# Generate a token locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_RECIPE_BASE_URL=http://192.168.0.123:5432
# Exact HTTP Host values (including port if supplied), only when a proxy needs them.
MCP_ALLOWED_HOSTS=
# Exact browser origins; normally empty (Inspector's proxy sends no Origin).
MCP_ALLOWED_ORIGINS=
# Use the existing application's COOKBOOK_DATA_DIR / COOKBOOK_DATABASE_URL.
